# Copy to chat_app/.env — Chainlit loads it on startup. Keys set here are
# picked up automatically; a key pasted into chat settings overrides them
# for that chat only (kept in memory, never written to chat history).

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# CUSTOM_OPENAI_API_KEY=

# Blender addon server (defaults: 127.0.0.1 / 9876)
# BLENDER_HOST=127.0.0.1
# BLENDER_PORT=9876

# Set to 0 to turn off local chat history (and the implicit local login)
# AGENT_BLEND_HISTORY=1
